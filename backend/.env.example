# Copia este archivo como .env para correrlo en tu computadora.
# En Render estas variables se ponen en Environment.

# Cadena de conexión de Neon (proyecto Compoint Check)
DATABASE_URL=postgresql://usuario:contrasena@host/neondb?sslmode=require

# Texto largo y secreto para firmar las sesiones
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto

# Clave que usará el agente del lector de huella
AGENTE_TOKEN=cambia-esta-clave-del-agente

# Opcional: zona horaria (por defecto America/Mexico_City)
# ZONA_HORARIA=America/Mexico_City

# Opcional (modo local): carpeta del frontend para que el mismo servidor lo entregue
# FRONTEND_DIR=../frontend

# Solo en los sistemas que Compoint crea para sus clientes (los pone el panel de compoint.com.mx):
# COMPOINT_LICENCIA_TOKEN=token-de-48-caracteres
# COMPOINT_LICENCIA_URL=https://www.compoint.com.mx/check/licencia.php
